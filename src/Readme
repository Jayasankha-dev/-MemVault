# 1. Initialize Git
git init

# 2. Add all files to staging
git add .

# 3. Commit the files
git commit -m "Initial commit: MemVault - High-Performance Memory Token Hunter"

# 4. Rename branch to main
git branch -M main

# 5. Add your remote repository
git remote add origin https://github.com/yourusername/memvault.git

# 6. Push to GitHub
git push -u origin main
